{% macro errorList(errors) %}
    {% if errors %}
        <ul class="mt-2 list-none p-0 text-sm text-red-700" role="alert">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{% set submission = submission ?? null %}
{% set preferredResponses = submission ? (submission.message['Preferred response'] ?? []) : [] %}

{% include '_partials/_head.twig' %}
<body class="bg-zinc-50">
    {% include '_partials/_nav2.twig' %}
    <main class="max-w-7xl mx-auto py-20  px-4">
        <div class="grid md:grid-cols-2 gap-10 mx-auto prose prose-lg prose-headings:text-yellow-900 max-w-none">
            <div class="px-4">
                <h2>Contact the Museum</h2>
                <p>We're always happy to hear from you, just drop us a line or give us a call and we'll get right back to you.</p>

                <div class="not-prose mt-8">
                    {% if craft.app.session.hasFlash('notice') %}
                        <p class="mb-6 rounded border border-green-300 bg-green-50 px-4 py-3 text-green-800" role="status">
                            {{ craft.app.session.getFlash('notice') }}
                        </p>
                    {% elseif craft.app.session.hasFlash('error') %}
                        <p class="mb-6 rounded border border-red-300 bg-red-50 px-4 py-3 text-red-800" role="alert">
                            {{ craft.app.session.getFlash('error') }}
                        </p>
                    {% endif %}

                    <form method="post" action="" accept-charset="UTF-8">
                        {{ csrfInput() }}
                        {{ actionInput('contact-form/send') }}
                        {{ hiddenInput('subject', 'Website contact form submission') }}

                        <div class="mb-8">
                            <label for="from-name" class="mb-3 block text-sm font-semibold text-gray-800">Name <span class="text-red-700" aria-hidden="true">*</span></label>
                            <input type="text" id="from-name" name="fromName" value="{{ submission.fromName ?? '' }}" autocomplete="name" required aria-required="true" class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 shadow-sm transition hover:border-gray-400 focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-200">
                            {{ submission ? _self.errorList(submission.getErrors('fromName')) }}
                        </div>

                        <div class="mb-8">
                            <label for="from-email" class="mb-3 block text-sm font-semibold text-gray-800">Email <span class="text-red-700" aria-hidden="true">*</span></label>
                            <input type="email" id="from-email" name="fromEmail" value="{{ submission.fromEmail ?? '' }}" autocomplete="email" required aria-required="true" class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 shadow-sm transition hover:border-gray-400 focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-200">
                            {{ submission ? _self.errorList(submission.getErrors('fromEmail')) }}
                        </div>

                        <div class="mb-8">
                            <label for="telephone" class="mb-3 block text-sm font-semibold text-gray-800">Telephone</label>
                            <input type="tel" id="telephone" name="message[Telephone]" value="{{ submission.message.Telephone ?? '' }}" autocomplete="tel" class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 shadow-sm transition hover:border-gray-400 focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-200">
                        </div>

                        <fieldset class="mb-8">
                            <legend class="mb-2 text-sm font-semibold text-gray-800">Preferred response</legend>
                            <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                                {% for response in ['Email', 'Phone', 'SMS'] %}
                                    <label class="inline-flex cursor-pointer items-center gap-2 py-2 text-gray-800">
                                        <input type="checkbox" name="message[Preferred response][]" value="{{ response }}"{{ response in preferredResponses ? ' checked' }} class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                                        <span class="text-sm font-medium">{{ response }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>

                        <div class="mb-8">
                            <label for="subject" class="mb-3 block text-sm font-semibold text-gray-800">Subject <span class="text-red-700" aria-hidden="true">*</span></label>
                            <textarea id="subject" name="message[body]" rows="7" required aria-required="true" class="w-full resize-y rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 shadow-sm transition hover:border-gray-400 focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-200">{{ submission.message.body ?? '' }}</textarea>
                            {{ submission ? _self.errorList(submission.getErrors('message')) }}
                        </div>

                        <div class="mb-8">
                            {{ craft.recaptcha.render() }}
                            {{ submission ? _self.errorList(submission.getErrors('recaptcha')) }}
                        </div>

                        <button type="submit" class="w-full rounded-lg bg-yellow-900 px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-yellow-800 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-yellow-700 focus:ring-offset-2 sm:w-auto">Send message</button>
                    </form>
                </div>
            </div>
            <div>
                <h2>Visit the Museum</h2>
                <div class="flex flex-wrap py-6 rounded shadow-md not-prose mb-20">
                    <div class="lg:w-1/2 px-6">
                        <h2 class=" text-gray-900  text-sm">HOURS</h2>
                        <p class="my-1 leading-tight text-gray-700">Weekends - Memorial Day through Labor Day, 1 to 4PM. Admission is free.</p>
                        <h2 class=" text-gray-900 text-sm mt-2">ADDRESS</h2>
                        <p class="mt-1">123 Church Street, Esperance, NY</p>
                    </div>
                    <div class="lg:w-1/2 px-6 mt-4 lg:mt-0">
                        <h2 class=" text-gray-900  text-sm">EMAIL</h2>
                        <a href="mailto:esperancehistoricalsociety@gmail.com" class="text-indigo-500 leading-tight text-sm">esperancehistoricalsociety@gmail.com</a>
                        <h2 class=" text-gray-900  text-sm mt-4">PHONE</h2>
                        <p class="leading-tight"><a href="tel:5188756854" class="text-indigo-500">518 875-6854</a></p>
                    </div>
                </div>
                <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d25571.4711738421!2d-74.2737569810362!3d42.76383439079226!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xc087be0f55dfd860!2sEsperance%20Historical%20Society!5e0!3m2!1sen!2sus!4v1656528373580!5m2!1sen!2sus" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class=" h-[450px] w-full"></iframe>
            </div>
        </div>
    </main>
    {% include '_partials/_footer.twig' %}
